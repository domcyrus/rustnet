#!/bin/sh
set -e

binary=/usr/bin/rustnet

enable_capabilities() {
    for capability do
        if ! capsh --supports="$capability" >/dev/null 2>&1 ||
           capsh --dropped="$capability" >/dev/null 2>&1; then
            echo "RustNet: $capability is unavailable during configuration." >&2
            return 1
        fi
    done

    # Join the requested capabilities for setcap without changing the caller's IFS.
    (IFS=,; setcap "$*=ep" "$binary")
}

configure_capabilities() {
    db_get rustnet/allow-capture
    if [ "$RET" = true ]; then
        db_get rustnet/enable-ebpf
        if [ "$RET" = true ]; then
            enable_capabilities cap_net_raw cap_bpf cap_perfmon && return 0
        else
            enable_capabilities cap_net_raw && return 0
        fi
    fi

    # Reconfiguring an existing binary must also revoke a previous grant.
    current=$(getcap "$binary")
    if [ -n "$current" ]; then
        setcap -r "$binary"
    fi
    echo "RustNet: file capabilities are disabled."
}

case "$1" in
    configure)
        . /usr/share/debconf/confmodule
        configure_capabilities
        db_stop

        cat <<EOF

To change capture permissions, run sudo dpkg-reconfigure ${DPKG_MAINTSCRIPT_PACKAGE:-rustnet-monitor}.
Inspect the result with getcap $binary.

GEOIP (OPTIONAL):
  To show country codes for remote IPs, install GeoLite2 databases:
    sudo apt-get install geoipupdate
  Edit /etc/GeoIP.conf with your free MaxMind credentials, then run:
    sudo geoipupdate
  See: https://github.com/domcyrus/rustnet/blob/main/INSTALL.md#geoip-databases-optional

USAGE:
  rustnet              # Start network monitoring
  rustnet --help       # Show all options

For more information, visit: https://github.com/domcyrus/rustnet
================================================================================

EOF
        ;;
esac

#DEBHELPER#

exit 0
